# ---------------------------------------------------------------
#  EcoWaste - variáveis de ambiente (exemplo)
#  Copie para ".env" e ajuste:   cp .env.example .env
#  O arquivo .env NÃO deve ir para o Git (já está no .gitignore).
# ---------------------------------------------------------------

# Nome do projeto no Docker (prefixo de containers, rede e volume)
COMPOSE_PROJECT_NAME=ecowaste-local

# Ambiente ASP.NET: Development | Staging | Production
APP_ENVIRONMENT=Development

# Porta publicada no host
API_PORT=8080

# Imagem da API (local = build pelo próprio compose)
API_IMAGE=ecowaste-api:local
APP_VERSION=local

# Banco Oracle (container gvenzl/oracle-free)
ORACLE_PASSWORD=TroqueEstaSenhaAdmin123
DB_USER=ecowaste
DB_PASSWORD=TroqueEstaSenhaApp123

# JWT - use uma chave longa (mínimo 32 caracteres)
JWT_SECRET=troque-esta-chave-por-uma-bem-longa-com-mais-de-32-caracteres
JWT_EXPIRATION_MINUTES=120

# Swagger habilitado?
ENABLE_SWAGGER=true
